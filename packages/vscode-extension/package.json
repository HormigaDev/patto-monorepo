{
    "name": "patto",
    "displayName": "Patto",
    "description": "Diagnostics and tooling for Patto Bot Template projects.",
    "version": "0.1.0",
    "publisher": "hormigadev",
    "license": "AGPL-3.0-only",
    "type": "commonjs",
    "main": "./dist/extension.js",
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "Patto runs the local patto CLI to analyze the current workspace, so trusted workspaces are required."
        }
    },
    "engines": {
        "vscode": "^1.90.0",
        "node": ">=18"
    },
    "categories": [
        "Linters",
        "Other"
    ],
    "keywords": [
        "patto",
        "discord",
        "bot",
        "lint",
        "diagnostics"
    ],
    "galleryBanner": {
        "color": "#5180d6",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/HormigaDev/patto-monorepo"
    },
    "bugs": {
        "url": "https://github.com/HormigaDev/patto-monorepo/issues"
    },
    "homepage": "https://github.com/HormigaDev/patto-monorepo#readme",
    "activationEvents": [
        "onStartupFinished",
        "onCommand:patto.check",
        "onCommand:patto.lint",
        "onCommand:patto.showCliSetup",
        "workspaceContains:.patto/config.json",
        "workspaceContains:src/core/structures/BaseCommand.ts"
    ],
    "contributes": {
        "commands": [
            {
                "command": "patto.check",
                "title": "Patto: Check Project"
            },
            {
                "command": "patto.lint",
                "title": "Patto: Lint Project"
            },
            {
                "command": "patto.showCliSetup",
                "title": "Patto: Show CLI Setup"
            }
        ],
        "configuration": {
            "title": "Patto",
            "properties": {
                "patto.enableDiagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable Patto diagnostics in the editor."
                },
                "patto.diagnosticsCommand": {
                    "type": "string",
                    "enum": [
                        "lint",
                        "check"
                    ],
                    "default": "check",
                    "description": "Core command used for editor diagnostics."
                },
                "patto.cliPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional path to the patto CLI executable."
                },
                "patto.runDiagnosticsOnOpen": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run Patto check when a Patto workspace is opened."
                },
                "patto.runDiagnosticsOnChange": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run Patto diagnostics after TypeScript or JSON files change."
                },
                "patto.runDiagnosticsOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run Patto diagnostics when TypeScript files are saved."
                },
                "patto.diagnosticsDebounceMs": {
                    "type": "number",
                    "default": 800,
                    "minimum": 100,
                    "maximum": 10000,
                    "description": "Delay before running Patto diagnostics after a file changes."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "tsc -p tsconfig.json",
        "build": "tsc -p tsconfig.json",
        "watch": "tsc -w -p tsconfig.json",
        "lint": "tsc -p tsconfig.json --noEmit",
        "package:vsix": "vsce package",
        "publish:marketplace": "vsce publish",
        "test": "echo \"tests pending\""
    },
    "devDependencies": {
        "@types/node": "^24.10.0",
        "@types/vscode": "^1.90.0",
        "@vscode/vsce": "^3.6.3",
        "typescript": "^6.0.3"
    }
}
